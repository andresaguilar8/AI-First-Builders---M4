# Copiar a .env y reemplazar los valores. El .env nunca se commitea (principio II).

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=gastos
POSTGRES_PASSWORD=cambiar-esta-contrasena
POSTGRES_DB=gastos

# Backend
ConnectionStrings__Default=Host=localhost;Port=5432;Database=gastos;Username=gastos;Password=cambiar-esta-contrasena

# Usuario único, creado al primer arranque (RF-37)
SEED_USER_EMAIL=usuario@example.com
SEED_USER_PASSWORD=cambiar-por-una-contrasena-larga-y-unica
